@model IEnumerable<BookStoreWeb.Models.DonHang>
@{
    ViewData["Title"] = "Đơn hàng của tôi";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="bi bi-bag"></i> Đơn hàng của tôi</h1>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary">
            <i class="bi bi-shop"></i> Tiếp tục mua sắm
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center py-5">
            <i class="bi bi-bag-x display-1 text-muted"></i>
            <h4 class="mt-3">Bạn chưa có đơn hàng nào</h4>
            <p class="text-muted">Hãy khám phá các sản phẩm và đặt hàng ngay!</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-2">
                <i class="bi bi-shop"></i> Mua sắm ngay
            </a>
        </div>
    }
    else
    {
        <div class="card shadow">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="bi bi-list-ul"></i> Lịch sử đơn hàng</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Mã ĐH</th>
                                <th>Ngày đặt</th>
                                <th>Tổng tiền</th>
                                <th>Phương thức</th>
                                <th>Trạng thái</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <span class="fw-bold text-primary">#@item.MaDonHang</span>
                                    </td>
                                    <td>
                                        @item.NgayDatHang.ToString("dd/MM/yyyy HH:mm")
                                    </td>
                                    <td>
                                        <span class="fw-bold text-danger">@item.TongTien.ToString("N0") đ</span>
                                    </td>
                                    <td>
                                        @if (item.PhuongThucThanhToan == "Tiền mặt")
                                        {
                                            <span class="badge bg-success"><i class="bi bi-cash-coin"></i> Tiền mặt</span>
                                        }
                                        else if (item.PhuongThucThanhToan == "MoMo")
                                        {
                                            <span class="badge bg-primary"><i class="bi bi-wallet2"></i> MoMo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@item.PhuongThucThanhToan</span>
                                        }
                                    </td>
                                    <td>
                                        @switch (item.TrangThai)
                                        {
                                            case "ChoXacNhan":
                                                <span class="badge bg-warning text-dark"><i class="bi bi-clock"></i> Chờ xác nhận</span>
                                                break;
                                            case "DangGiao":
                                                <span class="badge bg-info"><i class="bi bi-truck"></i> Đang giao</span>
                                                break;
                                            case "HoanThanh":
                                                <span class="badge bg-success"><i class="bi bi-check-circle"></i> Hoàn thành</span>
                                                break;
                                            case "Huy":
                                                <span class="badge bg-danger"><i class="bi bi-x-circle"></i> Đã hủy</span>
                                                break;
                                            default:
                                                <span class="badge bg-secondary">@item.TrangThai</span>
                                                break;
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a asp-action="ChiTiet" asp-route-id="@item.MaDonHang" class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            @if (item.TrangThai == "ChoXacNhan")
                                            {
                                                <form asp-action="HuyDonHang" asp-route-id="@item.MaDonHang" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn hủy đơn hàng này không?');">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Hủy đơn">
                                                        <i class="bi bi-x-lg"></i>
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
