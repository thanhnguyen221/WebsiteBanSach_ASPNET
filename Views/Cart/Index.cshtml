@model IEnumerable<BookStoreWeb.Models.CartItem>

@{
    ViewData["Title"] = "Giỏ hàng";
    var cartItems = Model.ToList();
    var totalAmount = cartItems.Sum(c => c.ThanhTien);
}

<div class="container mt-4">
    <h1 class="mb-4"><i class="bi bi-cart3"></i> Giỏ hàng của bạn</h1>

    @if (!cartItems.Any())
    {
        <div class="alert alert-info text-center py-5">
            <i class="bi bi-cart-x" style="font-size: 4rem;"></i>
            <h4 class="mt-3">Giỏ hàng trống</h4>
            <p>Bạn chưa có sản phẩm nào trong giỏ hàng.</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                <i class="bi bi-shop"></i> Tiếp tục mua sắm
            </a>
        </div>
    }
    else
    {
        <div class="row">
            <!-- Danh sách sản phẩm -->
            <div class="col-lg-8">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Sản phẩm</th>
                                        <th class="text-center">Đơn giá</th>
                                        <th class="text-center">Số lượng</th>
                                        <th class="text-end">Thành tiền</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in cartItems)
                                    {
                                        <tr data-product-id="@item.MaSP">
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    @if (!string.IsNullOrEmpty(item.HinhAnh))
                                                    {
                                                        <img src="~/images/@item.HinhAnh" alt="@item.TenSP" class="img-thumbnail me-3" style="width: 80px; height: 100px; object-fit: cover;">
                                                    }
                                                    else
                                                    {
                                                        <div class="bg-light d-flex align-items-center justify-content-center me-3" style="width: 80px; height: 100px;">
                                                            <i class="bi bi-book text-muted"></i>
                                                        </div>
                                                    }
                                                    <div>
                                                        <h6 class="mb-1">@item.TenSP</h6>
                                                        <small class="text-muted">Mã: @item.MaSP</small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="text-center">
                                                <span class="item-price">@item.Gia.ToString("N0")</span> đ
                                            </td>
                                            <td class="text-center">
                                                <div class="input-group input-group-sm" style="width: 120px; margin: 0 auto;">
                                                    <button class="btn btn-outline-secondary" type="button" onclick="updateCartQuantity(@item.MaSP, -1)">
                                                        <i class="bi bi-dash"></i>
                                                    </button>
                                                    <input type="number" class="form-control text-center quantity-input" value="@item.SoLuong" min="1" data-product-id="@item.MaSP" onchange="updateCartQuantityManual(@item.MaSP, this.value)">
                                                    <button class="btn btn-outline-secondary" type="button" onclick="updateCartQuantity(@item.MaSP, 1)">
                                                        <i class="bi bi-plus"></i>
                                                    </button>
                                                </div>
                                            </td>
                                            <td class="text-end">
                                                <span class="item-total fw-bold">@item.ThanhTien.ToString("N0")</span> đ
                                            </td>
                                            <td class="text-center">
                                                <button onclick="removeFromCart(@item.MaSP)" class="btn btn-outline-danger btn-sm">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="d-flex justify-content-between mt-3">
                            <button onclick="clearCart()" class="btn btn-outline-danger">
                                <i class="bi bi-trash"></i> Xóa toàn bộ giỏ
                            </button>
                            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary">
                                <i class="bi bi-arrow-left"></i> Tiếp tục mua sắm
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tổng tiền và thanh toán -->
            <div class="col-lg-4 mt-4 mt-lg-0">
                <div class="card shadow-sm bg-light">
                    <div class="card-body">
                        <h5 class="card-title mb-4">Tóm tắt đơn hàng</h5>

                        <div class="d-flex justify-content-between mb-2">
                            <span>Số lượng sản phẩm:</span>
                            <span id="totalItems" class="fw-bold">@cartItems.Sum(c => c.SoLuong)</span>
                        </div>

                        <div class="d-flex justify-content-between mb-2">
                            <span>Tạm tính:</span>
                            <span id="cartTotal">@totalAmount.ToString("N0") đ</span>
                        </div>

                        <hr />

                        <div class="d-flex justify-content-between mb-4">
                            <span class="h5">Tổng cộng:</span>
                            <span id="grandTotal" class="h4 text-primary fw-bold">@totalAmount.ToString("N0") đ</span>
                        </div>

                        <a asp-controller="Cart" asp-action="Checkout" class="btn btn-success btn-lg w-100">
                            <i class="bi bi-credit-card"></i> Thanh toán
                        </a>

                        <div class="mt-3 text-center">
                            <small class="text-muted">
                                <i class="bi bi-shield-check"></i> Thanh toán an toàn & bảo mật
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        function updateCartQuantity(productId, change) {
            const input = document.querySelector(`input[data-product-id="${productId}"]`);
            let currentQty = parseInt(input.value);
            let newQty = currentQty + change;

            if (newQty < 1) newQty = 1;

            updateCartQuantityManual(productId, newQty);
        }

        function updateCartQuantityManual(productId, quantity) {
            if (quantity < 1) quantity = 1;

            fetch('/Cart/UpdateQuantity', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: `productId=${productId}&quantity=${quantity}`
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Cập nhật giao diện
                    updateCartUI(data);
                    // Cập nhật input
                    const input = document.querySelector(`input[data-product-id="${productId}"]`);
                    if (input) input.value = quantity;
                    // Cập nhật thành tiền của item
                    const row = document.querySelector(`tr[data-product-id="${productId}"]`);
                    if (row) {
                        row.querySelector('.item-total').textContent = data.itemTotal;
                    }
                }
            })
            .catch(error => console.error('Error:', error));
        }

        function removeFromCart(productId) {
            if (!confirm('Bạn có chắc muốn xóa sản phẩm này khỏi giỏ hàng?')) return;

            fetch('/Cart/RemoveFromCart', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: `productId=${productId}`
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Xóa row khỏi bảng
                    const row = document.querySelector(`tr[data-product-id="${productId}"]`);
                    if (row) row.remove();

                    // Cập nhật UI
                    updateCartUI(data);

                    // Nếu giỏ trống, reload trang
                    if (data.cartCount === 0) {
                        location.reload();
                    }
                }
            })
            .catch(error => console.error('Error:', error));
        }

        function clearCart() {
            if (!confirm('Bạn có chắc muốn xóa toàn bộ giỏ hàng?')) return;

            fetch('/Cart/Clear', {
                method: 'POST'
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                }
            })
            .catch(error => console.error('Error:', error));
        }

        function updateCartUI(data) {
            // Cập nhật badge trong navbar
            const badge = document.querySelector('.cart-badge');
            if (badge) {
                badge.textContent = data.cartCount;
                badge.style.display = data.cartCount > 0 ? 'inline' : 'none';
            }

            // Cập nhật tổng tiền
            document.getElementById('totalItems').textContent = data.cartCount;
            document.getElementById('cartTotal').textContent = data.cartTotal + ' đ';
            document.getElementById('grandTotal').textContent = data.cartTotal + ' đ';
        }
    </script>
}
