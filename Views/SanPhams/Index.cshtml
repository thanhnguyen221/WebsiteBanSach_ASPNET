@model IEnumerable<BookStoreWeb.Models.SanPham>

@{
    ViewData["Title"] = "Quản lý Sản phẩm";
}

<div class="container mt-4">
    <h1 class="mb-4">@ViewData["Title"]</h1>

    <p>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Thêm sản phẩm mới
        </a>
    </p>

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Hình ảnh</th>
                    <th>@Html.DisplayNameFor(model => model.TenSach)</th>
                    <th>@Html.DisplayNameFor(model => model.TacGia)</th>
                    <th>@Html.DisplayNameFor(model => model.TheLoai)</th>
                    <th>@Html.DisplayNameFor(model => model.GiaBan)</th>
                    <th>@Html.DisplayNameFor(model => model.SoLuongTon)</th>
                    <th>Trạng thái</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(item.HinhAnh))
                            {
                                <img src="~/images/@item.HinhAnh" alt="@item.TenSach" class="img-thumbnail" style="max-width: 80px; max-height: 100px;" />
                            }
                            else
                            {
                                <div class="bg-light d-flex align-items-center justify-content-center" style="width: 80px; height: 100px;">
                                    <span class="text-muted small">No image</span>
                                </div>
                            }
                        </td>
                        <td>@Html.DisplayFor(modelItem => item.TenSach)</td>
                        <td>@Html.DisplayFor(modelItem => item.TacGia)</td>
                        <td>@Html.DisplayFor(modelItem => item.TheLoai)</td>
                        <td>@item.GiaBan.ToString("N0") đ</td>
                        <td>@Html.DisplayFor(modelItem => item.SoLuongTon)</td>
                        <td>
                            @if (item.ConHieuLuc)
                            {
                                <span class="badge bg-success">Còn bán</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Ngừng bán</span>
                            }
                        </td>
                        <td>
                            <div class="btn-group" role="group">
                                <a asp-action="Edit" asp-route-id="@item.MaSanPham" class="btn btn-warning btn-sm">
                                    <i class="bi bi-pencil"></i> Sửa
                                </a>
                                <a asp-action="Details" asp-route-id="@item.MaSanPham" class="btn btn-info btn-sm">
                                    <i class="bi bi-eye"></i> Chi tiết
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.MaSanPham" class="btn btn-danger btn-sm">
                                    <i class="bi bi-trash"></i> Xóa
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
