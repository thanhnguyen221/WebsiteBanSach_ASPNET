@model BookStoreWeb.Models.SanPham

@{
    ViewData["Title"] = "Chi tiết sản phẩm";
}

<div class="container mt-4">
    <h1 class="mb-4">@ViewData["Title"]</h1>

    <div class="row">
        <div class="col-md-4">
            @if (!string.IsNullOrEmpty(Model.HinhAnh))
            {
                <img src="~/images/@Model.HinhAnh" alt="@Model.TenSach" class="img-fluid rounded shadow" />
            }
            else
            {
                <div class="bg-light d-flex align-items-center justify-content-center rounded" style="height: 300px;">
                    <span class="text-muted">Không có hình ảnh</span>
                </div>
            }
        </div>
        <div class="col-md-8">
            <dl class="row">
                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.TenSach)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.TenSach)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.TacGia)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.TacGia)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NhaXuatBan)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.NhaXuatBan)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NamXuatBan)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.NamXuatBan)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.TheLoai)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.TheLoai)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.GiaBan)</dt>
                <dd class="col-sm-9 text-primary fw-bold">@Model.GiaBan.ToString("N0") đ</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SoLuongTon)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.SoLuongTon)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.MoTa)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.MoTa)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NgayTao)</dt>
                <dd class="col-sm-9">@Model.NgayTao.ToString("dd/MM/yyyy HH:mm")</dd>

                <dt class="col-sm-3">Trạng thái</dt>
                <dd class="col-sm-9">
                    @if (Model.ConHieuLuc)
                    {
                        <span class="badge bg-success">Còn bán</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Ngừng bán</span>
                    }
                </dd>
            </dl>

            <div class="mt-4">
                <a asp-action="Edit" asp-route-id="@Model.MaSanPham" class="btn btn-warning">
                    <i class="bi bi-pencil"></i> Sửa
                </a>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Quay lại danh sách
                </a>
            </div>
        </div>
    </div>
</div>
