@model BookStoreWeb.Models.SanPham

@{
    ViewData["Title"] = "Sửa sản phẩm";
}

<div class="container mt-4">
    <h1 class="mb-4">@ViewData["Title"]</h1>

    <div class="row">
        <div class="col-md-8">
            <form asp-action="Edit" enctype="multipart/form-data" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="MaSanPham" />
                <input type="hidden" asp-for="HinhAnh" />
                <input type="hidden" asp-for="NgayTao" />

                <div class="mb-3">
                    <label asp-for="TenSach" class="form-label"></label>
                    <input asp-for="TenSach" class="form-control" />
                    <span asp-validation-for="TenSach" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="TacGia" class="form-label"></label>
                        <input asp-for="TacGia" class="form-control" />
                        <span asp-validation-for="TacGia" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="NhaXuatBan" class="form-label"></label>
                        <input asp-for="NhaXuatBan" class="form-control" />
                        <span asp-validation-for="NhaXuatBan" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="NamXuatBan" class="form-label"></label>
                        <input asp-for="NamXuatBan" class="form-control" type="number" />
                        <span asp-validation-for="NamXuatBan" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="TheLoai" class="form-label"></label>
                        <input asp-for="TheLoai" class="form-control" />
                        <span asp-validation-for="TheLoai" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="GiaBan" class="form-label"></label>
                        <div class="input-group">
                            <input asp-for="GiaBan" class="form-control" type="number" step="0.01" placeholder="Nhập giá (VD: 130000)" />
                            <span class="input-group-text">đ</span>
                        </div>
                        <span asp-validation-for="GiaBan" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="SoLuongTon" class="form-label"></label>
                        <input asp-for="SoLuongTon" class="form-control" type="number" />
                        <span asp-validation-for="SoLuongTon" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="MoTa" class="form-label"></label>
                    <textarea asp-for="MoTa" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="MoTa" class="text-danger"></span>
                </div>

                @if (!string.IsNullOrEmpty(Model.HinhAnh))
                {
                    <div class="mb-3">
                        <label class="form-label">Hình ảnh hiện tại</label>
                        <div>
                            <img src="~/images/@Model.HinhAnh" alt="@Model.TenSach" class="img-thumbnail" style="max-width: 200px;" />
                        </div>
                    </div>
                }

                <div class="mb-3">
                    <label for="HinhAnhFile" class="form-label">
                        @(string.IsNullOrEmpty(Model.HinhAnh) ? "Chọn hình ảnh" : "Thay đổi hình ảnh")
                    </label>
                    <input type="file" name="HinhAnhFile" id="HinhAnhFile" class="form-control" accept="image/*" />
                    <div class="form-text">Chọn file ảnh mới để thay thế (tùy chọn). Tên file sẽ được tự động sinh.</div>
                </div>

                <div class="mb-3 form-check">
                    <input asp-for="ConHieuLuc" class="form-check-input" />
                    <label asp-for="ConHieuLuc" class="form-check-label"></label>
                </div>

                <div class="mb-3">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save"></i> Cập nhật
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Quay lại
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
