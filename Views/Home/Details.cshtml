            padding-left: 15px;
        }

        /* Tag User */
        .tag-user {
            color: #0d6efd;
            font-weight: 500;
            cursor: pointer;
        }
        
        .tag-user:hover {
            text-decoration: underline;
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .star-rating-input i {
                font-size: 1.5rem !important;
            }
            
            .rating-bars .d-flex {
