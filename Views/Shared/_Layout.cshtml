<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BookStoreWeb</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BookStoreWeb.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">BookStoreWeb</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="SanPhams" asp-action="Index">
                                    <i class="bi bi-box-seam"></i> Quản lý Sản phẩm
                                </a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link text-dark position-relative" asp-area="" asp-controller="Cart" asp-action="Index">
                                <i class="bi bi-cart3 fs-5"></i>
                                <span class="cart-badge badge bg-danger position-absolute top-0 start-100 translate-middle" style="display: none;">0</span>
                                <span class="d-sm-none ms-2">Giỏ hàng</span>
                            </a>
                        </li>
                    </ul>
                    <ul class="navbar-nav ms-2">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle"></i> Xin chào, @User.Identity.Name
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li>
                                            <a class="dropdown-item" asp-controller="AdminDashboard" asp-action="Index">
                                                <i class="bi bi-speedometer2 text-primary"></i> Dashboard
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="SanPhams" asp-action="Index">
                                                <i class="bi bi-box-seam"></i> Quản lý sản phẩm
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="AdminDonHang" asp-action="Index">
                                                <i class="bi bi-clipboard-check"></i> Quản lý đơn hàng
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                    }
                                    <li>
                                        <a class="dropdown-item" asp-controller="DonHang" asp-action="LichSu">
                                            <i class="bi bi-bag"></i> Đơn hàng của tôi
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Wishlist" asp-action="Index">
                                            <i class="bi bi-heart"></i> Sách yêu thích
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="TaiKhoan" asp-action="Logout" method="post" class="d-inline">
                                            <button type="submit" class="dropdown-item">
                                                <i class="bi bi-box-arrow-right"></i> Đăng xuất
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="TaiKhoan" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right"></i> Đăng nhập
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link btn btn-outline-success btn-sm ms-1" asp-controller="TaiKhoan" asp-action="Register">
                                    <i class="bi bi-person-plus"></i> Đăng ký
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="bg-dark text-light py-4 mt-5">
        <div class="container">
            <div class="row">
                <div class="col-md-4 mb-3">
                    <h5><i class="bi bi-book"></i> BookStore</h5>
                    <p class="text-muted small">Hệ thống bán sách trực tuyến hiện đại, cung cấp đa dạng các đầu sách chất lượng với trải nghiệm mua sắm tiện lợi.</p>
                </div>
                <div class="col-md-4 mb-3">
                    <h5>Liên hệ</h5>
                    <ul class="list-unstyled text-muted small">
                        <li><i class="bi bi-geo-alt"></i> 123 Đường Sách, Quận 1, TP.HCM</li>
                        <li><i class="bi bi-telephone"></i> (028) 1234-5678</li>
                        <li><i class="bi bi-envelope"></i> support@bookstore.com</li>
                    </ul>
                </div>
                <div class="col-md-4 mb-3">
                    <h5>Liên kết nhanh</h5>
                    <ul class="list-unstyled small">
                        <li><a asp-controller="Home" asp-action="Index" class="text-light text-decoration-none">Trang chủ</a></li>
                        <li><a asp-controller="Cart" asp-action="Index" class="text-light text-decoration-none">Giỏ hàng</a></li>
                        <li><a asp-controller="TaiKhoan" asp-action="Login" class="text-light text-decoration-none">Đăng nhập</a></li>
                    </ul>
                </div>
            </div>
            <hr class="border-secondary" />
            <div class="text-center text-muted small">
                &copy; 2026 BookStoreWeb - Đồ án ASP.NET Core MVC |
                <a asp-controller="Home" asp-action="Privacy" class="text-light text-decoration-none">Chính sách bảo mật</a>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
