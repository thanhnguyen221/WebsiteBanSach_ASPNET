@model BookStoreWeb.Models.NguoiDung

@{
    ViewData["Title"] = "Đăng ký tài khoản";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-success text-white text-center">
                    <h4><i class="bi bi-person-plus"></i> Đăng ký tài khoản</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Register" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="mb-3">
                            <label asp-for="HoTen" class="form-label"></label>
                            <input asp-for="HoTen" class="form-control" required placeholder="Nhập họ tên của bạn" />
                            <span asp-validation-for="HoTen" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" type="email" required placeholder="example@email.com" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="MatKhau" class="form-label">Mật khẩu</label>
                                <input type="password" name="MatKhau" id="MatKhau" class="form-control" required
                                       minlength="6" placeholder="Ít nhất 6 ký tự" />
                                <span asp-validation-for="MatKhau" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="xacNhanMatKhau" class="form-label">Xác nhận mật khẩu</label>
                                <input type="password" name="xacNhanMatKhau" id="xacNhanMatKhau" class="form-control" required
                                       placeholder="Nhập lại mật khẩu" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="SoDienThoai" class="form-label"></label>
                            <input asp-for="SoDienThoai" class="form-control" placeholder="Số điện thoại (tùy chọn)" />
                            <span asp-validation-for="SoDienThoai" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DiaChi" class="form-label"></label>
                            <textarea asp-for="DiaChi" class="form-control" rows="2" placeholder="Địa chỉ giao hàng (tùy chọn)"></textarea>
                            <span asp-validation-for="DiaChi" class="text-danger"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-person-check"></i> Đăng ký
                            </button>
                        </div>
                    </form>

                    <hr class="my-4" />

                    <div class="text-center">
                        <p class="mb-0">Đã có tài khoản?</p>
                        <a asp-action="Login" class="btn btn-outline-primary mt-2">
                            <i class="bi bi-box-arrow-in-right"></i> Đăng nhập
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
